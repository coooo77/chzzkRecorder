{
  "checkIntervalSec": 30,
  "ffmpeg": "path/to/bin/ffmpeg.exe",
  "ffprobe": "path/to/bin/ffprobe.exe",
  "streamlink": "path/to/bin/streamlink.exe",
  "filenameTemplate": "{username}_{id}_Chzzk_{year}{month}{day}_{hr}{min}{sec}",
  "filenameVodTemplate": "{username}_{id}_ChzzkVod_{vodNum}_{year}{month}{day}_{hr}{min}{sec}_{duration}",
  "saveDirectory": "D:/Path/to/folder",
  "usePuppeteer": true,
  "proactiveSearch": true,
  "useLiveFFmpegOutput": true,
  "dlVodConcurrency": 2,
  "dlVodConcurrencySchedule": [
    {
      "timeStart": "15:45",
      "timeEnd": "23:00",
      "concurrency": 4
    },
    {
      "timeStart": "23:01",
      "timeEnd": "07:00",
      "concurrency": 10
    }
  ],
  "checkUserVodMinutes": [
    60,
    360,
    720
  ],
  "userSettingOverride": {
    "disableRecord": true
  },
  "puppeteerSettings": {
    "headless": false,
    "executablePath": "C:/Path/to/Google/Chrome/Application/chrome.exe"
  }
}